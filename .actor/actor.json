{
  "actorSpecification": 1,
  "name": "booking-com-hotel-scraper",
  "title": "Booking.com Scraper - $2/1k, Rooms, Prices & Availability",
  "description": "Scrape Booking.com by destination or saved search URL. Export hotels, live stay prices, room options, availability, facilities, photos, policies, ratings, addresses, coordinates, and surroundings.",
  "version": "1.0",
  "buildTag": "latest",
  "categories": ["TRAVEL"],
  "categoriesVersion": "1.0.0",
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "readme": "../README.md",
  "output": "./output_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "hotels": {
          "title": "Hotel Records",
          "transformation": {
            "fields": [
              "destination",
              "scrapeMode",
              "billingTier",
              "hotelName",
              "starRating",
              "guestReviewScore",
              "reviewCount",
              "totalPrice",
              "pricePerNight",
              "currency",
              "availabilityStatus",
              "checkIn",
              "checkOut",
              "address",
              "latitude",
              "longitude",
              "city",
              "country",
              "distanceFromCityCenter",
              "freeCancellation",
              "propertyUrl",
              "propertyId",
              "roomOptions",
              "facilities",
              "imageUrls",
              "surroundings",
              "scrapedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "destination": { "label": "Destination", "format": "text" },
              "scrapeMode": { "label": "Mode", "format": "text" },
              "billingTier": { "label": "Billing Tier", "format": "text" },
              "hotelName": { "label": "Hotel", "format": "text" },
              "starRating": { "label": "Stars", "format": "number" },
              "guestReviewScore": { "label": "Guest Score", "format": "number" },
              "reviewCount": { "label": "Reviews", "format": "number" },
              "totalPrice": { "label": "Total Price", "format": "number" },
              "pricePerNight": { "label": "Per Night", "format": "number" },
              "currency": { "label": "Currency", "format": "text" },
              "availabilityStatus": { "label": "Availability", "format": "text" },
              "checkIn": { "label": "Check-in", "format": "text" },
              "checkOut": { "label": "Check-out", "format": "text" },
              "address": { "label": "Address", "format": "text" },
              "latitude": { "label": "Latitude", "format": "number" },
              "longitude": { "label": "Longitude", "format": "number" },
              "city": { "label": "City", "format": "text" },
              "country": { "label": "Country", "format": "text" },
              "distanceFromCityCenter": { "label": "Distance From City Center", "format": "text" },
              "freeCancellation": { "label": "Free Cancellation", "format": "boolean" },
              "propertyUrl": { "label": "URL", "format": "link" },
              "propertyId": { "label": "Property ID", "format": "text" },
              "scrapedAt": { "label": "Scraped At", "format": "date" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts running. Number of events charged depends on Actor memory (one event per GB, minimum one event).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "hotel-scraped": {
          "eventTitle": "Hotel scraped",
          "eventDescription": "Charged once for each clean Booking.com hotel record saved to the dataset.",
          "eventPriceUsd": 0.002,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        },
        "detailed-hotel-scraped": {
          "eventTitle": "Detailed hotel scraped",
          "eventDescription": "Charged for each enriched property record with room, policy, facility, image, address, coordinate, and availability data.",
          "eventPriceUsd": 0.005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": false
        },
        "detailed-run-started": {
          "eventTitle": "Detailed mode setup",
          "eventDescription": "Charged once per detailed-mode run for browser startup and Booking.com session setup.",
          "eventPriceUsd": 0.002,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        }
      }
    }
  },
  "exampleRunInput": {
    "body": "{\"destinations\":[\"London, United Kingdom\"],\"adults\":2,\"rooms\":1,\"childrenAges\":[],\"propertyTypes\":[],\"stars\":[],\"minReviewScore\":0,\"sortBy\":\"popularity\",\"maxResults\":1,\"currency\":\"USD\",\"language\":\"en-us\",\"scrapeDetails\":true,\"maxImages\":10,\"proxyConfiguration\":{\"useApifyProxy\":true}}",
    "contentType": "application/json; charset=utf-8"
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 1024,
    "timeoutSecs": 1200
  },
  "minMemoryMbytes": 1024,
  "maxMemoryMbytes": 2048,
  "webScraper": false
}
